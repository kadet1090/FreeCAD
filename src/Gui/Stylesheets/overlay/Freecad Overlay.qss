Gui--DockWnd--ReportOutput,
Gui--TaskView--TaskView QScrollArea {
  border: none;
  background-color: transparent;
}

Gui--OverlayTitleBar,
Gui--OverlaySplitterHandle {
  background-color: @{@Background.200};
 }

Gui--OverlaySplitter {
    margin: @{padding(vertical: @Spacing.100, horizontal: @Spacing.400)};
}

/* Overwrites Properties panel to use white text. */
Gui--TreePanel QTreeView {
  background-color: transparent;
  border: 0px solid   @BaseTextColor;
  color: @BaseTextColor;
  gridline-color: @BaseBorderColor;
  border-radius: 0px;
}

/* Appearance moved to design system; margin is layout not yet expressible as token. */
Gui--OverlayTabWidget::pane {
  margin: 25px;
}

QSint--ActionGroup QFrame[class="content"] {
  border-bottom: 1px solid @BaseBorderColor;
  border-left: 1px solid @BaseBorderColor;
  border-right: 1px solid @BaseBorderColor;
  border-top-left-radius: 0px;
  border-top-right-radius: 0px;
  border-bottom-left-radius: 3px;
  border-bottom-right-radius: 3px;
}

QSint--ActionGroup QFrame[class="header"] {
  border: 1px solid @BaseBorderColor;
  /* border-bottom: 0px solid @BaseBorderColor; */
  border-top-left-radius: 3px;
  border-top-right-radius: 3px;
  border-bottom-left-radius: 0px;
  border-bottom-right-radius: 0px;
}

Gui--OverlayProxyWidget {
  qproperty-hintColor: rgba(250, 250, 250, 0.6);
  background-color: red;
}
